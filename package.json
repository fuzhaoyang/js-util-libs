    "license": "MIT",
    "main": "index.js",
    "module": "dist/index.mjs",
    "types": "index.d.ts",
    "unpkg": "dist/index.global.js",
    "jsdelivr": "dist/index.global.js",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "browser": "./dist/index.mjs",
            "import": "./dist/index.mjs",
            "require": "./index.js",
            "default": "./index.js"
        },
        "./package.json": "./package.json",
        "./*": "./*"
    },
    "private": false,
    "scripts": {
